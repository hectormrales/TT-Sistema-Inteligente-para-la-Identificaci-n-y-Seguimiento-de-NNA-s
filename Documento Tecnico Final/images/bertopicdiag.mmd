flowchart TD
    %% Entradas y Salidas
    In([Corpus de noticias filtradas]) --> E
    
    %% Caja contenedora del Pipeline
    subgraph PipelineModularDeBERTopic["Flujo modular de BERTopic"]
        direction TB
        
        E[1. Embeddings<br/><i>SentenceTransformer</i>]
        U[2. Reducción Topológica<br/><i>UMAP</i>]
        H[3. Agrupamiento por densidad<br/><i>HDBSCAN</i>]
        C["4. Representación léxica<br/><i>c-TF-IDF (CountVectorizer)</i>"]
        
        %% Flujo de datos con descripciones
        E -->|Tensores multilingües de 768 dimensiones| U
        U -->|Tensores reducidos a 5 dimensiones| H
        H -->|Asignación de clústeres y outliers| C
    end
    
    C -->|Extracción de n-gramas clave| Out([15 Grupos Temáticos Finales])

    %% Nodos de hiperparámetros (conectados con líneas punteadas)
    classDef paramNode fill:#f4f4f4,stroke:#666,stroke-width:1px,stroke-dasharray: 5 5,font-size:12px;
    
    Ep["Modelo: paraphrase-multilingual-MiniLM-L12-v2"]:::paramNode
    Up["n_components: 5<br/>n_neighbors: 15<br/>min_dist: 0.0<br/>metric: cosine"]:::paramNode
    Hp["min_cluster_size: 8<br/>min_samples: 5<br/>method: eom<br/>prediction_data: True"]:::paramNode
    Cp["ngram_range: (1, 3)<br/>min_df: 2<br/>stop_words: Español"]:::paramNode

    %% Conexiones de parámetros
    E -.- Ep
    U -.- Up
    H -.- Hp
    C -.- Cp
    
    %% Estilos de los nodos principales
    style E fill:#e1f5fe,stroke:#03a9f4,stroke-width:2px
    style U fill:#e8f5e9,stroke:#4caf50,stroke-width:2px
    style H fill:#fff3e0,stroke:#ff9800,stroke-width:2px
    style C fill:#f3e5f5,stroke:#9c27b0,stroke-width:2px