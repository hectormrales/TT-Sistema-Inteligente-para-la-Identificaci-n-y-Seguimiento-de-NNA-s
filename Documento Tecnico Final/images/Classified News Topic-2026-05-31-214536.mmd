flowchart TD
    classDef firewall fill:#424242,stroke:#fff,stroke-width:2px,color:#fff
    classDef fail fill:#ffebee,stroke:#c62828,stroke-width:2px,color:#c62828
    classDef success fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#2e7d32
    classDef logic fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef neutral fill:#f5f5f5,stroke:#9e9e9e,stroke-width:2px
%% Mitad Derecha: La Solución
    subgraph Solucion ["La solucion (StealthSession)"]
        direction TB
        S1["Suplantación TLS<br>(cloudscraper)"]:::logic --> S2["Firma criptográfica<br>(JA3 idéntico a Chrome/Win)"]:::logic
        S2 --> W2{"WAF<br>(cloudflare/akamai)"}:::firewall
        W2 -->|"Aprobado"| S3["Patrón de lectura<br>(delays log-normal)"]:::logic
        S3 --> S4{"Circuit breaker<br>(por dominio)"}:::logic
        S4 -->|"Conexión estable"| S5["Extracción exitosa<br>85%+ tasa de exito"]:::success
        S4 -->|3 fallos| S6["Cooldown (300s)<br>Evita baneo de IP"]:::neutral
    end

    style Solucion stroke:none, fill:none