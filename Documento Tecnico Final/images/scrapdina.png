---
config:
  layout: fixed
---
flowchart TB
 subgraph Solucion[" "]
    direction TB
        S2["Firma criptográfica<br>(JA3 idéntico a Chrome/Win)"]
        S1["Suplantación TLS (cloudscraper)"]
        W2{"WAF<br>(cloudflare/akamai)"}
        S3["Patrón de lectura<br>(delays log-normal)"]
        S4{"Circuit breaker<br>(por dominio)"}
        S5["Extracción exitosa<br>85%+ tasa de exito"]
        S6["Cooldown (300s)<br>Evita baneo de IP"]
  end
    S1 --> S2
    S2 --> W2
    W2 -- Aprobado --> S3
    S3 --> S4
    S4 -- Conexión estable --> S5
    S4 -- 3 fallos --> S6

     S2:::logic
     S1:::logic
     W2:::firewall
     S3:::logic
     S4:::logic
     S5:::success
     S6:::neutral
    classDef firewall fill:#424242,stroke:#fff,stroke-width:2px,color:#fff
    classDef fail fill:#ffebee,stroke:#c62828,stroke-width:2px,color:#c62828
    classDef success fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#2e7d32
    classDef logic fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef neutral fill:#f5f5f5,stroke:#9e9e9e,stroke-width:2px
    style Solucion stroke:none, fill:none