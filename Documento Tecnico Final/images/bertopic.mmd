    IN["Corpus Completo<br>(600+ noticias)"] --> B("BETO Embeddings<br>768D")
    B -.-> B_Desc["Representación semántica<br>de alta dimensionalidad"]
    B --> U("UMAP<br>Reducción a 5D")
    U -.-> U_Desc["Preserva estructura local<br>y relaciones semánticas"]
    U --> H("HDBSCAN<br>Clustering de Densidad")
    H -.-> H_Desc["Encuentra grupos densos<br>y aísla ruido u outliers"]
    H --> TID{"Asignación de<br>topic_id"}
    TID -- topic_id ≥ 0<br>(Clúster temático coherente) --> U1["Contexto Normal<br>Umbral BETO: 0.50"]
    TID -- "topic_id = -1<br>(Outlier / Posible ruido)" --> U2["Contexto de Incertidumbre<br>Umbral BETO: 0.65"]
    S10 -.-> S9

