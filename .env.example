# ============================================================
# NNA Monitor — Configuración de Variables de Entorno (.env.example)
# Copia este archivo como `.env` y coloca tus credenciales.
# ============================================================

# --- 1. Motor de IA y Extracción Estructurada (LLMExtractor) ---
# Proveedor principal gratuito recomendado: Groq Cloud (openai/gpt-oss-20b)
# Obtén tu clave gratis en 1 minuto (sin tarjeta) en: https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_tu_api_key_aqui
GROQ_MODEL=openai/gpt-oss-20b

# Opcionales de respaldo o producción:
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://tu-recurso.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# --- 2. Base de Datos PostgreSQL ---
POSTGRES_USER=nna_admin
POSTGRES_PASSWORD=cambia_este_password_seguro
POSTGRES_DB=nna_auth_db
POSTGRES_HOST=nna-postgres
POSTGRES_PORT=5432

# --- 3. Aplicación Web Flask y Seguridad ---
FLASK_ENV=development
SECRET_KEY=genera_una_clave_secreta_larga_y_aleatoria_aqui
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia_este_password_admin
ADMIN_EMAIL=contacto@futuroconderechos.org
