# ============================================================
# Variables de Entorno - Sistema NNA
# ============================================================
# INSTRUCCIONES:
# 1. Copia este archivo como .env:  cp .env.example .env
# 2. Genera claves seguras con:     python -c "import secrets; print(secrets.token_hex(32))"
# 3. NUNCA subas el archivo .env a control de versiones.
# ============================================================

# --- Flask ---
FLASK_APP=app_docker.py
FLASK_ENV=production
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIAR_POR_CLAVE_SEGURA_GENERADA

# --- Base de Datos PostgreSQL ---
POSTGRES_USER=nna_admin
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
POSTGRES_DB=nna_auth_db
POSTGRES_HOST=nna-postgres
POSTGRES_PORT=5432
# La URI se construye automáticamente en config.py; no es necesario definirla aquí.

# --- Seguridad ---
# Tiempo máximo de sesión inactiva (en minutos)
SESSION_LIFETIME_MINUTES=60
